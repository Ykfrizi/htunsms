rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeAccount() {
      return signedIn() && request.auth.token.accountStatus == 'active';
    }

    function hasPermission(permission) {
      return activeAccount()
        && request.auth.token.permissions is list
        && permission in request.auth.token.permissions;
    }

    match /users/{uid} {
      allow read: if activeAccount() && (request.auth.uid == uid || hasPermission('users:read'));
      allow create, update, delete: if false;
    }

    match /personnel/{personnelId} {
      allow read: if activeAccount()
        && (resource.data.userId == request.auth.uid || hasPermission('personnel:read'));
      allow create, update, delete: if false;
    }

    match /applications/{applicationId} {
      allow read: if activeAccount()
        && (resource.data.personnelUid == request.auth.uid || hasPermission('applications:read'));
      allow create, update, delete: if false;
    }

    match /documents/{documentId} {
      allow read: if activeAccount()
        && (resource.data.personnelUid == request.auth.uid || hasPermission('documents:read'));
      allow create, update, delete: if false;
    }

    match /departments/{id} {
      allow read: if activeAccount();
      allow write: if false;
    }
    match /directorates/{id} {
      allow read: if activeAccount();
      allow write: if false;
    }
    match /units/{id} {
      allow read: if activeAccount();
      allow write: if false;
    }

    match /deployments/{deploymentId} {
      allow read: if activeAccount()
        && (resource.data.personnelUid == request.auth.uid
          || hasPermission('deployments:read')
          || (hasPermission('reporting:read') && request.auth.token.unitIds is list
            && resource.data.unitId in request.auth.token.unitIds));
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if activeAccount() && resource.data.recipientUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if hasPermission('audit:read');
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
